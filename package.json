{
  "name": "zombie-pixel-fps",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview --port 4310",
    "verify": "npm run verify:sim && npm run verify:exp",
    "verify:sim": "esbuild test/wave-base.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/rot-verify/wave-base.mjs --log-level=error && node node_modules/.cache/rot-verify/wave-base.mjs",
    "verify:exp": "esbuild test/exp-verify.ts --bundle --platform=node --format=esm --define:import.meta.env.DEV=false --outfile=node_modules/.cache/rot-verify/exp-verify.mjs --log-level=error && node node_modules/.cache/rot-verify/exp-verify.mjs"
  },
  "dependencies": {
    "@types/three": "^0.186.0",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@fontsource/press-start-2p": "^5.3.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  },
  "description": "ROT PROTOCOL — a browser-based pixel-art zombie FPS built with Vite, TypeScript and Three.js. Ten waves, three bosses, one finale.",
  "license": "MIT",
  "author": "Ashar Qaisar <noahext994@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/Noah-zipit/rot-protocol.git"
  },
  "homepage": "https://noah-zipit.github.io/rot-protocol/",
  "keywords": [
    "game",
    "fps",
    "three.js",
    "vite",
    "typescript",
    "pixel-art"
  ]
}
